<Window x:Class="Mp3Player.LyricWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面歌词"
        Width="760" Height="132"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border CornerRadius="14" Background="#D9101624" BorderBrush="#26FFFFFF" BorderThickness="1">
        <Grid>
            <Button Style="{StaticResource IconButtonStyle}" Width="30" Height="30"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                    Click="Close_Click" ToolTip="关闭桌面歌词">
                <Path Data="M6,6 L18,18 M18,6 L6,18"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" Stretch="Uniform" Width="10" Height="10"/>
            </Button>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="SongTitleText" Text="歌曲"
                           Foreground="{StaticResource TextDimBrush}" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock x:Name="CurrentText" Text="等待播放…"
                           Foreground="White" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NextText" Text=""
                           Foreground="#99FFFFFF" FontSize="13"
                           HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
