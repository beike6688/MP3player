<Window x:Class="Mp3Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="炫音播放器"
        Icon="Assets/app.ico"
        Width="1280" Height="800"
        MinWidth="1040" MinHeight="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing">

    <Border x:Name="RootBorder" ClipToBounds="True"
            CornerRadius="24"
            Background="{StaticResource BgBrush}"
            BorderBrush="#2AFFFFFF"
            BorderThickness="1">
        <Grid x:Name="RootContent">
            <Grid.Clip>
                <RectangleGeometry x:Name="RootClipGeometry" RadiusX="24" RadiusY="24"/>
            </Grid.Clip>
            <!-- ========== 背景层：渐变 + 霓虹光晕 + 封面模糊 ========== -->
            <Grid x:Name="BgLayer" IsHitTestVisible="False">
                <Border>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#10162F" Offset="0"/>
                            <GradientStop Color="#080B18" Offset="0.5"/>
                            <GradientStop Color="#050713" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Ellipse Width="560" Height="560" HorizontalAlignment="Left" VerticalAlignment="Center"
                         Margin="-170,0,0,0" Fill="{StaticResource PurpleGlowBrush}">
                    <Ellipse.Effect>
                        <BlurEffect Radius="80"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Ellipse Width="640" Height="640" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Margin="0,0,-220,0" Fill="{StaticResource BlueGlowBrush}">
                    <Ellipse.Effect>
                        <BlurEffect Radius="100"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Image x:Name="BgCoverImage" Stretch="UniformToFill" Opacity="0.35">
                    <Image.Effect>
                        <BlurEffect Radius="70"/>
                    </Image.Effect>
                </Image>
                <Border Background="#B3080B18"/>
            </Grid>

            <!-- ========== 内容层 ========== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶栏 -->
                <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4E8CFF" Offset="0"/>
                                    <GradientStop Color="#9B6BFF" Offset="0.55"/>
                                    <GradientStop Color="#FF5FA2" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="M9,4 V15.5 C8.4,15.2 7.7,15 7,15 C4.8,15 3,16.8 3,19 C3,21.2 4.8,23 7,23 C9.2,23 11,21.2 11,19 V10 H17 V4 Z"
                                  Fill="White" Stretch="Uniform" Margin="6"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="炫音播放器" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="17" FontWeight="Bold" FontFamily="Microsoft YaHei UI"/>
                            <TextBlock Text="专注本地音乐播放" Foreground="#8A90A8"
                                       FontSize="11" Margin="0,1,0,0" FontFamily="Microsoft YaHei UI"/>
                        </StackPanel>
                        <TextBlock x:Name="TopSongText" Text="未播放" Foreground="{StaticResource TextDimBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="26,6,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource CaptionButtonStyle}" Click="Minimize_Click" ToolTip="最小化">
                            <Path Data="M6,11.5 H18 V13.5 H6 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}" Click="Maximize_Click" ToolTip="最大化">
                            <Path x:Name="MaximizeIcon" Data="M6,6 H18 V18 H6 Z M8,8 H16 V16 H8 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                        <Button Style="{StaticResource CloseButtonStyle}" Click="Close_Click" ToolTip="关闭">
                            <Path Data="M6,6 L18,18 M18,6 L6,18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Stretch="Uniform" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 主体：三栏 -->
                <Grid Grid.Row="1" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30*"/>
                        <ColumnDefinition Width="40*"/>
                        <ColumnDefinition Width="30*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== 左：黑胶唱片 + 歌曲信息 ===== -->
                    <Grid Grid.Column="0" Margin="16,0,8,0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                        <Grid x:Name="CdContainer" Width="320" Height="320" ClipToBounds="True"
                              VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse Stroke="{StaticResource AccentGradientBrush}" StrokeThickness="3" Opacity="0.9" IsHitTestVisible="False">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#9B6BFF" BlurRadius="26" ShadowDepth="0" Opacity="0.7"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <!-- 旋转盘 -->
                            <Grid x:Name="CdSpinTarget" Margin="10" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="CdRotate"/>
                                </Grid.RenderTransform>
                                <Grid.Resources>
                                    <Storyboard x:Key="CdSpinStoryboard">
                                        <DoubleAnimation Storyboard.TargetName="CdRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:10"
                                                         RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </Grid.Resources>
                                <Ellipse Fill="#080808"/>
                                <Ellipse Margin="16" Stroke="#1CFFFFFF" StrokeThickness="1"/>
                                <Ellipse Margin="34" Stroke="#12FFFFFF" StrokeThickness="1"/>
                                <Ellipse Margin="52" Stroke="#10FFFFFF" StrokeThickness="1"/>
                                <Ellipse Margin="50">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="CdImageBrush" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Margin="50" Fill="{StaticResource CdShineBrush}"/>
                                <Ellipse Width="36" Height="36" Fill="#0A0A0A"/>
                                <Ellipse Width="14" Height="14" Fill="#333B4F"/>
                            </Grid>

                            <!-- 唱臂（最上层，根部在容器内） -->
                            <Grid x:Name="ToneArmContainer" Width="118" Height="172"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Margin="0,8,-4,0" IsHitTestVisible="False"
                                  RenderTransformOrigin="0.9,1">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="ToneArmRotate" Angle="-26"/>
                                </Grid.RenderTransform>
                                <Border Width="6" Height="116" CornerRadius="3"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,32,4">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#3A4256" Offset="0"/>
                                            <GradientStop Color="#D9E2F5" Offset="0.35"/>
                                            <GradientStop Color="#454F66" Offset="0.7"/>
                                            <GradientStop Color="#7B8498" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Path Data="M0,0 H30 L26,24 H4 Z" Fill="#242B3C"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                      Margin="0,0,8,2" Width="30" Height="24"/>
                                <Ellipse Width="16" Height="16" Fill="#1A2030" Stroke="#FFFFFF44" StrokeThickness="1"
                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
                            </Grid>
                        </Grid>

                        <!-- 歌曲信息 -->
                        <StackPanel Margin="0,42,0,0">
                            <TextBlock x:Name="TitleText" Text="未选择歌曲"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold"
                                       FontFamily="Microsoft YaHei UI"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                            <StackPanel x:Name="FormatTagsPanel" Orientation="Horizontal"
                                        HorizontalAlignment="Center" Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                <Border x:Name="FormatTag1" Background="#202842" CornerRadius="6"
                                        Padding="9,3" Margin="0,0,6,0">
                                    <TextBlock x:Name="FormatTagText1" Text="" Foreground="#AEB9D0"
                                               FontSize="11" FontFamily="Microsoft YaHei UI"/>
                                </Border>
                                <Border x:Name="FormatTag2" Background="#202842" CornerRadius="6"
                                        Padding="9,3" Margin="0,0,6,0">
                                    <TextBlock x:Name="FormatTagText2" Text="" Foreground="#AEB9D0"
                                               FontSize="11" FontFamily="Microsoft YaHei UI"/>
                                </Border>
                                <Border x:Name="FormatTag3" Background="#202842" CornerRadius="6"
                                        Padding="9,3">
                                    <TextBlock x:Name="FormatTagText3" Text="" Foreground="#AEB9D0"
                                               FontSize="11" FontFamily="Microsoft YaHei UI"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ===== 中：实时频谱 ===== -->
                    <Grid Grid.Column="1" Margin="10,8,10,6">
                        <Border CornerRadius="20" Background="Transparent" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.55*"/>
                                    <RowDefinition Height="0.45*"/>
                                </Grid.RowDefinitions>
                                <UniformGrid x:Name="VisGrid" Grid.Row="0" Rows="1" Margin="26,20,26,0"/>
                                <UniformGrid x:Name="VisReflectionGrid" Grid.Row="1" Rows="1" Margin="26,0,26,16"
                                             Opacity="0.32">
                                    <UniformGrid.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                            <GradientStop Color="#8CFFFFFF" Offset="0.35"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </UniformGrid.OpacityMask>
                                    <UniformGrid.Effect>
                                        <BlurEffect Radius="3"/>
                                    </UniformGrid.Effect>
                                </UniformGrid>
                                <Canvas x:Name="ParticleCanvas" Grid.Row="0" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===== 右：播放列表 ===== -->
                    <Grid Grid.Column="2" Margin="8,8,16,6">
                        <Border CornerRadius="18" Background="Transparent"
                                BorderBrush="#14FFFFFF" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="44"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="12,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="PlaylistCountText" Text="播放列表 (0)"
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold"
                                                   FontFamily="Microsoft YaHei UI"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource IconButtonStyle}" Width="34" Height="34"
                                                Click="AddFolder_Click" ToolTip="添加文件夹">
                                            <Path Data="M3,6 H9 L11,8 H21 V18 H3 Z"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.4" Fill="Transparent"
                                                  Stretch="Uniform" Width="15" Height="15"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" Width="34" Height="34"
                                                Click="AddSongs_Click" ToolTip="添加歌曲">
                                            <Path Data="M12,5 V19 M5,12 H19"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2" Stretch="Uniform" Width="15" Height="15"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <ListBox x:Name="PlaylistBox" Grid.Row="1"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     Style="{StaticResource PlaylistListBoxStyle}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource PlaylistItemStyle}"
                                     AllowDrop="True"
                                     DragOver="PlaylistBox_DragOver"
                                     Drop="PlaylistBox_Drop"
                                     MouseDoubleClick="PlaylistBox_MouseDoubleClick"
                                     PreviewKeyDown="PlaylistBox_PreviewKeyDown">
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBarStyle}"/>
                                    </ListBox.Resources>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="48">
                                            <Border x:Name="RowBg" CornerRadius="10" Background="Transparent"/>
                                            <Border x:Name="Indicator" Width="3" CornerRadius="1.5"
                                                    HorizontalAlignment="Left" Margin="0,12,0,12" Visibility="Collapsed">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#4E8CFF" Offset="0"/>
                                                        <GradientStop Color="#FF5FA2" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Grid Margin="14,0,10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="IndexText" Text="{Binding Number}" FontSize="12"
                                                           Foreground="{StaticResource TextDimBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                <StackPanel x:Name="PlayingBadge" Orientation="Horizontal" Visibility="Collapsed"
                                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Rectangle Width="3" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="#FF5FA2" VerticalAlignment="Bottom" Margin="0,0,2,0"/>
                                                    <Rectangle Width="3" Height="14" RadiusX="1.5" RadiusY="1.5" Fill="#FF5FA2" VerticalAlignment="Bottom" Margin="0,0,2,0"/>
                                                    <Rectangle Width="3" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="#FF5FA2" VerticalAlignment="Bottom"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="SongTitle" Text="{Binding DisplayTitle}"
                                                               FontSize="12.5" TextTrimming="CharacterEllipsis"
                                                               Foreground="#99A3BA"
                                                               FontFamily="Microsoft YaHei UI"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                                           FontSize="10.5" Foreground="{StaticResource TextDimBrush}"
                                                           VerticalAlignment="Center" Margin="10,0,2,0"/>
                                            </Grid>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter TargetName="RowBg" Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#264E8CFF" Offset="0"/>
                                                            <GradientStop Color="#269B6BFF" Offset="0.6"/>
                                                            <GradientStop Color="#26FF5FA2" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="IndexText" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="PlayingBadge" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="SongTitle" Property="Foreground" Value="#FFD05CFF"/>
                                                <Setter TargetName="SongTitle" Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== 底部控制栏 ===== -->
                <Grid Grid.Row="2" Margin="24,0,24,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="86"/>
                    </Grid.RowDefinitions>

                    <!-- 均衡器面板 -->
                    <Border x:Name="EqPanel" Grid.Row="0" Visibility="Collapsed"
                            CornerRadius="14" Background="#E611182D" Padding="20,12" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="均衡器" Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="12" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <UniformGrid x:Name="EqSlidersGrid" Columns="5" Grid.Column="1"/>
                            <Button Grid.Column="2" Content="重置" Foreground="{StaticResource TextSecondaryBrush}"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    FontSize="12" Margin="20,0,0,0" VerticalAlignment="Center"
                                    Click="ResetEq_Click"/>
                        </Grid>
                    </Border>

                    <!-- 进度条 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CurrentTimeText" Text="00:00" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Width="44"/>
                        <Grid Grid.Column="1" x:Name="SeekArea" Height="22" Background="Transparent"
                              MouseLeftButtonDown="SeekArea_MouseDown"
                              MouseMove="SeekArea_MouseMove"
                              MouseLeftButtonUp="SeekArea_MouseUp">
                            <ProgressBar x:Name="SeekBar" Style="{StaticResource SeekProgressStyle}" Value="0" Maximum="1"/>
                            <Ellipse x:Name="SeekThumb" Width="18" Height="18" Fill="White"
                                     VerticalAlignment="Center" HorizontalAlignment="Left"
                                     Margin="-9,0,0,0" IsHitTestVisible="False">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#9B6BFF" BlurRadius="12" ShadowDepth="0" Opacity="0.95"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="TotalTimeText" Text="00:00" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12" VerticalAlignment="Center" Width="44" TextAlignment="Right" Grid.Column="2"/>
                    </Grid>

                    <!-- 控制按钮行 -->
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ModeButton" Style="{StaticResource IconButtonStyle}" Click="ModeButton_Click"
                                    ToolTip="播放模式">
                                <Grid>
                                    <Path x:Name="ModeIcon" Data="M7,7 H17 V10 L21,6 L17,2 V5 H5 V11 H7 Z M17,17 H7 V14 L3,18 L7,22 V19 H19 V13 H17 Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Stretch="Uniform" Width="19" Height="19"/>
                                    <TextBlock x:Name="ModeBadge" Text="1" FontSize="7" FontWeight="Bold"
                                               Foreground="White" Margin="9,7,0,0" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}" Click="Prev_Click" ToolTip="上一曲 (Ctrl+←)" Margin="0,0,10,0">
                                <Path Data="M18,18 L9.5,12 L18,6 Z M6,6 V18 H8 V6 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform" Width="22" Height="22"/>
                            </Button>
                            <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButtonStyle}" Click="PlayPause_Click">
                                <Grid Width="80" Height="80">
                                    <Path x:Name="PlayIcon" Data="M10,6 V26 L27,16 Z" Fill="White"
                                          Stretch="Uniform" Width="26" Height="26" Margin="3,0,0,0"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Path x:Name="PauseIcon" Data="M9,6 H13.5 V26 H9 Z M18.5,6 H23 V26 H18.5 Z"
                                          Fill="White" Stretch="Uniform" Width="26" Height="26"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Click="Next_Click" ToolTip="下一曲 (Ctrl+→)" Margin="10,0,0,0">
                                <Path Data="M6,18 L14.5,12 L6,6 Z M16,6 V18 H18 V6 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform" Width="22" Height="22"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Grid Width="176" Margin="0,0,14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="VolumeIcon" Data="M4,9 V15 H8 L13,19 V5 L8,9 Z"
                                      MouseLeftButtonDown="VolumeIcon_MouseDown" Cursor="Hand"
                                      Fill="{StaticResource TextSecondaryBrush}"
                                      Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="17" Height="17"
                                      Stretch="Uniform" VerticalAlignment="Center"/>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <ProgressBar x:Name="VolumeBar" Style="{StaticResource VolumeProgressStyle}"
                                                 Value="0.8" Maximum="1"/>
                                    <Slider x:Name="VolumeSlider" Style="{StaticResource TransparentSliderStyle}"
                                            Minimum="0" Maximum="1" Value="0.8"
                                            ValueChanged="VolumeSlider_ValueChanged"/>
                                </Grid>
                                <TextBlock x:Name="VolumePercentText" Grid.Column="2" Text="80%"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11.5" VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>
                            <Button x:Name="EqToggleButton" Style="{StaticResource IconButtonStyle}" Click="EqToggle_Click"
                                    ToolTip="均衡器">
                                <Path Data="M3,9 H5 V15 H3 Z M8,3 H10 V21 H8 Z M13,7 H15 V17 H13 Z M18,5 H20 V19 H18 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Stretch="Uniform" Width="18" Height="18"/>
                            </Button>
                            <Button x:Name="LyricToggleButton" Style="{StaticResource IconButtonStyle}" Click="LyricToggle_Click"
                                    ToolTip="桌面歌词">
                                <Path Data="M4,5 H20 V15 H13 L11,19 L10,15 H4 Z M8,9 H16 M8,11.5 H13"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4" Fill="Transparent"
                                      Stretch="Uniform" Width="18" Height="18"/>
                            </Button>
                            <Button Style="{StaticResource IconButtonStyle}" Click="MiniMode_Click" ToolTip="迷你模式">
                                <Path Data="M4,4 H20 V16 H4 Z M9,8 H15 V12 H9 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3" Fill="Transparent"
                                      Stretch="Uniform" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 模式菜单（窗口内自绘，避免 Popup 定位问题） -->
            <Border x:Name="ModeMenuPanel" Visibility="Collapsed"
                    Background="#F211182D" CornerRadius="12" BorderBrush="#33FFFFFF"
                    BorderThickness="1" Padding="5" Panel.ZIndex="100"
                    VerticalAlignment="Top" HorizontalAlignment="Left">
                <StackPanel MinWidth="132">
                    <Button x:Name="ModeOrderButton" Content="顺序播放" Tag="0"
                            Click="ModeChoice_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#EAF0FF"
                            FontSize="13" HorizontalContentAlignment="Left" Padding="12,9"
                            Cursor="Hand" FontFamily="Microsoft YaHei UI"/>
                    <Button x:Name="ModeRepeatOneButton" Content="单曲循环" Tag="1"
                            Click="ModeChoice_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#EAF0FF"
                            FontSize="13" HorizontalContentAlignment="Left" Padding="12,9"
                            Cursor="Hand" FontFamily="Microsoft YaHei UI"/>
                    <Button x:Name="ModeShuffleButton" Content="随机播放" Tag="2"
                            Click="ModeChoice_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#EAF0FF"
                            FontSize="13" HorizontalContentAlignment="Left" Padding="12,9"
                            Cursor="Hand" FontFamily="Microsoft YaHei UI"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
