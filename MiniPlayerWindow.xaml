<Window x:Class="Mp3Player.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="炫音播放器 - 迷你模式"
        Width="520" Height="88"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border CornerRadius="14" Background="#F20F1522" BorderBrush="#2EFFFFFF" BorderThickness="1">
        <Grid Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Width="58" Height="58" CornerRadius="10" Background="#182238">
                <Image x:Name="CoverImage" Stretch="UniformToFill">
                    <Image.Clip>
                        <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,58,58"/>
                    </Image.Clip>
                </Image>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                <TextBlock x:Name="TitleText" Text="未播放" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ArtistText" Text="" Foreground="{StaticResource TextDimBrush}"
                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButtonStyle}" Click="Prev_Click" ToolTip="上一曲">
                    <Path Data="M18,18 L9.5,12 L18,6 Z M6,6 V18 H8 V6 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform" Width="17" Height="17"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="PlayPause_Click" ToolTip="播放/暂停">
                    <Grid Width="40" Height="40">
                        <Path x:Name="PlayIcon" Data="M8,5 V19 L20,12 Z" Fill="White"
                              Stretch="Uniform" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="PauseIcon" Data="M7,5 H10.5 V19 H7 Z M13.5,5 H17 V19 H13.5 Z"
                              Fill="White" Stretch="Uniform" Width="17" Height="17"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="Next_Click" ToolTip="下一曲">
                    <Path Data="M6,18 L14.5,12 L6,6 Z M16,6 V18 H18 V6 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform" Width="17" Height="17"/>
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Click="Expand_Click" ToolTip="展开主窗口">
                    <Path Data="M7,17 H17 V7 H7 Z M10,10 H14 V14 H10 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" Fill="Transparent" Stretch="Uniform" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
